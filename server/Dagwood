project dache_server

set CC        clang
set BUILD_DIR build
set LINK_OPTS [list -larchive -lcrypto -lstdc++]
set OUT       $::BUILD_DIR/dache_server
set OPTS      [list -g -O0 -std=c++17]
set TARGETS   [glob src/*.cpp src/*.hpp src/*.c src/*.h]
set C_CMDS    compile_commands.json


task pre-reqs {
    run {
	mkdir -p $::BUILD_DIR
    }
}

task build {
    description "Build Dache CLI"
    depends-on  pre-reqs
    inputs      $::TARGETS
    outputs     $::OUT
    run {
	$::CC $::TARGETS $::OPTS $::LINK_OPTS -o $::OUT
    }
}

task bear {
    inputs  $::dache_server::build::inputs
    outputs $::C_CMDS
    run {
	bear -- $::dache_server::build::run
    }
}

command clean {
    run {
	rm -rf $::BUILD_DIR
    }
}

