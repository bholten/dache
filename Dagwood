project dache

let CC        gcc
let BUILD_DIR build
let LINK_OPTS [list -larchive -lcrypto -lz]
let OUT       $BUILD_DIR/dache
let TARGETS   [glob src/*.c src/*.h]
let C_CMDS    compile_commands.json
let STANDARD_OPTS [list -std=c11 -Os -D_POSIX_C_SOURCE=200809L \
                        -Wall -Wextra -Wpedantic \
                        -Wstrict-overflow -fno-strict-aliasing]
let DEBUG_OPTS   [list -g -O0 -DDEBUG @$STANDARD_OPTS]
let RELEASE_OPTS [list -O2 -DNDEBUG -s -march=native @$STANDARD_OPTS]

task prereqs {
    run {
        mkdir -p $dache::BUILD_DIR
    }
}

task fmt {
    depends_on build
    inputs $dache::TARGETS
    outputs .clang-format
    run {
        set -e
        clang-format -i $dache::TARGETS
        touch .clang-format
    }
}

proc cc_compile {src output includes} {
    var inc
    var header_flags ""

    if [empty? $includes] {
        set! inc {}
    } else {
        set! inc $includes
    }
    
    foreach {dir} $incs {
        String::append header_flags " -I${dir}"
    }
}

proc build {name build_args} {
    eval [subst {
        task $name {
            description "Build Dache CLI"
            depends_on  dache::prereqs
            inputs      \$dache::TARGETS
            outputs     \$dache::OUT
            run {
                \$dache::CC \$dache::TARGETS $build_args \$dache::LINK_OPTS -o \$dache::OUT
            }
        }
    }]
}

build debug   $dache::DEBUG_OPTS
build release $dache::RELEASE_OPTS

task bear {
    depends_on dache::debug
    inputs     $dache::debug::inputs
    outputs    $dache::C_CMDS
    run {
        bear -- $dache::debug::run
    }
}

command clean {
    run {
        rm -rf $dache::BUILD_DIR
    }
}
