project dache

set CC        gcc
set BUILD_DIR build
set LINK_OPTS [list -larchive -lcrypto]
set OUT       $::BUILD_DIR/dache
set OPTS      [list -g -O0 -std=c11 -D_POSIX_C_SOURCE=200809L]
set TARGETS   [glob src/*.c src/*.h]
set C_CMDS    compile_commands.json


task pre-reqs {
    run {
	mkdir -p $::BUILD_DIR
    }
}

task build {
    description "Build Dache CLI"
    depends-on  pre-reqs
    inputs      $::TARGETS
    outputs     $::OUT
    run {
	$::CC $::TARGETS $::OPTS $::LINK_OPTS -o $::OUT
    }
}

task bear {
    inputs  $::dache::build::inputs
    outputs $::C_CMDS
    run {
	bear -- $::dache::build::run
    }
}

command clean {
    run {
	rm -rf $::BUILD_DIR
    }
}

